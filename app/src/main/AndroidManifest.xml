<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 외부 저장소 읽기 권한 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- 카메라 권한 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- 외부 저장소 쓰기 권한 (필요할 경우) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- 인터넷과 통신하기 위해-->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 명시적으로 전화 기능이 필요하지 않음을 선언 -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- 맨위에 2줄 http접근 허용 -->
    <application
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"

        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_mediforme_logo2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_mediforme_logo2_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediForMe"
        tools:targetApi="31">
        <activity
            android:name=".ui.login.SearchmainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.login.SearchpwdFragment"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <activity
            android:name=".ui.login.SearchIDFragment"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinNameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinServiceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinIdActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinVericodeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.join.JoinPhoneActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.AddMedicineActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.AddMedicineResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.splash.SplashActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.search.SearchResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.OnboardingAgeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.CameraActivity"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.OnboardingDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.SearchWithNameActivity"
            android:exported="false" />
        <activity
            android:name=".ui.onboarding.OnboardingMedicineActivity"
            android:exported="true" />
        <activity
            android:name=".ui.splash.SplashChoiceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.CheckMedicineActivity"
            android:exported="false" />
    </application>

</manifest>